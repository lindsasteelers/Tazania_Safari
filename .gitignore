<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to GitHub</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      line-height: 1.6;
      background: #f4f4f4;
      color: #333;
    }
    header {
      background: #24292e;
      color: #fff;
      padding: 20px 0;
      text-align: center;
    }
    header h1 {
      margin: 0;
      font-size: 2.5em;
    }
    .container {
      max-width: 1100px;
      margin: auto;
      padding: 20px;
    }
    .feature {
      background: #fff;
      margin: 20px 0;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    .feature h2 {
      margin-top: 0;
      color: #0366d6;
    }
    footer {
      text-align: center;
      padding: 10px 0;
      background: #24292e;
      color: #fff;
      margin-top: 20px;
    }
    a {
      color: #0366d6;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <header>
    <h1>Welcome to GitHub</h1>
    <p>Your platform for code collaboration and version control.</p>
  </header>
  <div class="container">
    <div class="feature">
      <h2>What is GitHub?</h2>
      <p>GitHub is a platform for developers to host and review code, manage projects, and build software together. It uses Git version control to track changes in your code.</p>
    </div>
    <div class="feature">
      <h2>Key Features</h2>
      <ul>
        <li><strong>Repositories:</strong> Store and organize your code projects.</li>
        <li><strong>Pull Requests:</strong> Collaborate and review code changes.</li>
        <li><strong>Issues:</strong> Track tasks, bugs, and feature requests.</li>
        <li><strong>Actions:</strong> Automate workflows with CI/CD tools.</li>
      </ul>
    </div>
    <div class="feature">
      <h2>Get Started</h2>
      <p>Sign up today and join millions of developers on GitHub! <a href="https://github.com">Visit GitHub</a>.</p>
    </div>
  </div>
  <footer>
    <p>&copy; 2025 GitHub, Inc. All rights reserved.</p>
  </footer>
</body>
</html>




# Ignore list for Eagle, a PCB layout tool

# Backup files
*.s#?
*.b#?
*.l#?
*.b$?
*.s$?
*.l$?

# Eagle project file
# It contains a serial number and references to the file structure
# on your computer.
# comment the following line if you want to have your project file included.
eagle.epf

# Autorouter files
*.pro
*.job

# CAM files
*.$$$
*.cmp
*.ly2
*.l15
*.sol
*.plc
*.stc
*.sts
*.crc
*.crs

*.dri
*.drl
*.gpi
*.pls
*.ger
*.xln

*.drd
*.drd.*

*.s#*
*.b#*

*.info

*.eps

# file locks introduced since 7.x
*.lck
